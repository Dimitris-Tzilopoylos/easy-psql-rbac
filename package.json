{
  "name": "easy-psql-rbac",
  "version": "1.0.0",
  "description": "Role-based access control layer for easy-psql",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/",
    "README.md"
  ],
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "build:watch": "tsc --project tsconfig.json --watch",
    "test": "jest",
    "benchmark": "ts-node src/__benchmarks__/rbac.bench.ts",
    "prepublishOnly": "npm test && npm run build"
  },
  "keywords": [
    "rbac",
    "postgres",
    "postgresql",
    "easy-psql",
    "authorization",
    "permissions",
    "access-control",
    "column-security",
    "orm",
    "typescript"
  ],
  "author": "Dimitris Tzilopoylos <dimtzilopoylos@gmail.com>",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dimitris-Tzilopoylos/easy-psql-rbac.git"
  },
  "homepage": "https://github.com/Dimitris-Tzilopoylos/easy-psql-rbac#readme",
  "bugs": {
    "url": "https://github.com/Dimitris-Tzilopoylos/easy-psql-rbac/issues"
  },
  "type": "commonjs",
  "dependencies": {
    "easy-validation-service": "^1.0.8"
  },
  "peerDependencies": {
    "easy-psql": ">=1.0.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.19.19",
    "easy-psql": "^1.0.8",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
